# Renqun web. Everything here is optional: the defaults are the live Mezo testnet deployment.
NEXT_PUBLIC_MEZO_NETWORK=testnet
NEXT_PUBLIC_MEZO_RPC_URL=
# YosukuPredict address and deploy block, to point the site at another deployment
NEXT_PUBLIC_MEZO_PREDICT=
NEXT_PUBLIC_MEZO_DEPLOY_BLOCK=
# Starter drip: gas and test MUSD on testnet. Production uses this site's own /api (set to /api);
# `next dev` defaults to services/drip on http://localhost:8787.
NEXT_PUBLIC_MEZO_DRIP_URL=
# Server only: the drip wallet's key, for /api/drip. Never NEXT_PUBLIC.
DRIP_PRIVATE_KEY=
