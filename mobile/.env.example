# Renqun app. Everything here is optional: the defaults are the live Mezo testnet deployment.
# Wallet keys are generated on the device. Never put a key in an EXPO_PUBLIC_* variable:
# Expo inlines those into the app bundle.

# testnet (default) or mainnet
EXPO_PUBLIC_MEZO_NETWORK=testnet
EXPO_PUBLIC_MEZO_RPC_URL=
# YosukuPredict address and its deploy block, to point the app at another deployment
EXPO_PUBLIC_YOSUKU_MEZO_PREDICT=
EXPO_PUBLIC_YOSUKU_MEZO_DEPLOY_BLOCK=
# Starter drip. Testnet defaults to the hosted one (https://renqun.app/api); http://localhost:8787 uses
# services/drip on this machine.
EXPO_PUBLIC_MEZO_DRIP_URL=
